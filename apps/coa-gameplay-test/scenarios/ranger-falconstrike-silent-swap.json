{
  "schema": 1,
  "name": "Falconstrike stands in for Quick Shot without a single chat line, and only while it is ready",
  "contract": "While the Falconstrike talent 573060 is taken, SyncFalconstrike learns Falconstrike 806443 once as a temporary spell (#6333), and its cast check refuses it until Falconstrike Ready 573338 is up. The buff replaces Quick Shot 500074 with Falconstrike, and its end hands Quick Shot back. Each of those once reached the client as a packet it prints a line for: SMSG_LEARNED_SPELL ('You have learned a new spell'), SMSG_SUPERCEDED_SPELL (the same line) and SMSG_REMOVED_SPELL ('You have unlearned'). With CoA.TemporarySpellReplacement.Silent the temporary learn arrives with Falconstrike's SpellCustomAttr row quiet, the swap is an action bar redraw, and the end of the swap drops Falconstrike through SMSG_SUPERCEDED_SPELL to the hidden placeholder 22050, which the client neither announces nor shows. The client knows Falconstrike from the talent until the first proc ends, then only while it stands in, and a second proc works the same way.",
  "timeout_ms": 60000,
  "players": [
    { "id": "ranger", "race": 1, "class": 21, "level": 80 }
  ],
  "steps": [
    { "action": "wait", "label": "Let login state settle", "ms": 3000 },
    { "action": "learn", "actor": "ranger", "spell": 500074 },
    { "action": "learn", "actor": "ranger", "spell": 573060 },
    { "action": "set_action_button", "actor": "ranger", "button": 1, "spell": 500074 },
    { "action": "wait", "ms": 1200 },
    {
      "action": "snapshot", "actor": "ranger", "metric": "client_chat_lines_for", "spell": 806443,
      "save_as": "falconstrike_lines"
    },
    {
      "action": "snapshot", "actor": "ranger", "metric": "client_chat_lines_for", "spell": 500074,
      "save_as": "quick_shot_lines"
    },
    {
      "action": "assert", "label": "SETUP: the talent teaches the client Falconstrike before it is ready",
      "actor": "ranger", "metric": "client_knows_spell", "spell": 806443, "equals": 1
    },
    {
      "action": "assert", "label": "Learning Falconstrike from the talent printed nothing",
      "actor": "ranger", "metric": "client_chat_lines_for", "spell": 806443, "equals": 0
    },
    { "action": "set_aura", "label": "Falconstrike is ready", "actor": "ranger", "spell": 573338, "stacks": 1 },
    {
      "action": "assert", "label": "Quick Shot turns into Falconstrike",
      "actor": "ranger", "metric": "temporary_spell_replacement", "spell": 500074, "equals": 806443,
      "within_ms": 2000
    },
    {
      "action": "assert", "label": "The client knows Falconstrike while it stands in",
      "actor": "ranger", "metric": "client_knows_spell", "spell": 806443, "equals": 1
    },
    {
      "action": "assert", "label": "The client's button carries Falconstrike",
      "actor": "ranger", "metric": "client_action_button", "button": 1, "equals": 806443
    },
    {
      "action": "assert", "label": "Learning Falconstrike printed nothing",
      "actor": "ranger", "metric": "client_chat_lines_for", "spell": 806443,
      "relative_to": "falconstrike_lines", "equals": 0
    },
    { "action": "set_aura", "label": "Falconstrike is used up", "actor": "ranger", "spell": 573338, "stacks": 0 },
    {
      "action": "assert", "label": "Falconstrike hands Quick Shot back",
      "actor": "ranger", "metric": "temporary_spell_replacement", "spell": 500074, "equals": 500074,
      "within_ms": 2000
    },
    {
      "action": "assert", "label": "The client's button carries Quick Shot again",
      "actor": "ranger", "metric": "client_action_button", "button": 1, "equals": 500074
    },
    {
      "action": "assert", "label": "Falconstrike leaves the client's spellbook",
      "actor": "ranger", "metric": "client_knows_spell", "spell": 806443, "equals": 0
    },
    {
      "action": "assert", "label": "The client still knows Quick Shot",
      "actor": "ranger", "metric": "client_knows_spell", "spell": 500074, "equals": 1
    },
    {
      "action": "assert", "label": "Dropping Falconstrike printed nothing",
      "actor": "ranger", "metric": "client_chat_lines_for", "spell": 806443,
      "relative_to": "falconstrike_lines", "equals": 0
    },
    {
      "action": "assert", "label": "Handing Quick Shot back printed nothing",
      "actor": "ranger", "metric": "client_chat_lines_for", "spell": 500074,
      "relative_to": "quick_shot_lines", "equals": 0
    },
    { "action": "wait", "ms": 1200 },
    { "action": "set_aura", "label": "Falconstrike is ready again", "actor": "ranger", "spell": 573338, "stacks": 1 },
    {
      "action": "assert", "label": "A second proc swaps Quick Shot again",
      "actor": "ranger", "metric": "temporary_spell_replacement", "spell": 500074, "equals": 806443,
      "within_ms": 2000
    },
    {
      "action": "assert", "label": "The client knows Falconstrike again",
      "actor": "ranger", "metric": "client_knows_spell", "spell": 806443, "equals": 1
    },
    {
      "action": "assert", "label": "The second proc printed nothing either",
      "actor": "ranger", "metric": "client_chat_lines_for", "spell": 806443,
      "relative_to": "falconstrike_lines", "equals": 0
    }
  ]
}
