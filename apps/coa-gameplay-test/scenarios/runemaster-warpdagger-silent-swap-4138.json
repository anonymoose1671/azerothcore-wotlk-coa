{
  "schema": 1,
  "name": "Warpdagger swaps to Warp and back without a chat line or a new action button (#4138, #4820, #6196, #6618)",
  "contract": [
    "Throwing Warpdagger 500287 teaches Warp 500587 as a temporary spell and swaps it in through",
    "SetTemporarySpellReplacement; warping back clears the swap. Each swap used to reach the client as",
    "SMSG_SUPERCEDED_SPELL, which prints a learned line and makes the client place the new spell on an empty",
    "button, so every use added copies to the bar. With CoA.TemporarySpellReplacement.Silent the swap is a bar redraw",
    "and the learn is quiet. Expected over two uses: the Warpdagger button shows Warp and then Warpdagger again, an",
    "empty button stays empty, no SMSG_SUPERCEDED_SPELL is sent and the client prints no line for either spell."
  ],
  "timeout_ms": 60000,
  "location": {"map": 0, "x": -8949.95, "y": -132.493, "z": 83.5312, "o": 0},
  "players": [
    {"id": "rm", "race": 1, "class": 32, "level": 80}
  ],
  "steps": [
