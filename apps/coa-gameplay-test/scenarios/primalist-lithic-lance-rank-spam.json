{
  "schema": 1,
  "name": "Lithic Lance Ready supersedes only the highest known Geode Barrage rank",
  "contract": "Lithic Lance Ready retargets one action-bar slot, the highest Geode Barrage rank the caster knows, to Lithic Lance. Gaining or losing the buff retargets no other rank, however many earlier Geode Barrage ranks remain in the spellbook, and the client prints no line for it: the swap is written into the bar server side and the bar is resent, and no SMSG_SUPERCEDED_SPELL hands a Geode Barrage rank back.",
  "players": [
    {
      "id": "primalist",
      "race": 1,
      "class": 31,
      "level": 80
    }
  ],
  "timeout_ms": 30000,
  "steps": [
