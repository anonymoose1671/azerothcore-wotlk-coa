{
  "schema": 1,
  "name": "Guardian Advance swaps to its stomp and back without learned or unlearned lines (#408, #6475)",
  "contract": [
    "Half a second into Advance 500170, AscensionGuardianTalents::Synchronize teaches its stomp 500673 as a temporary",
    "spell and swaps it in; when Advance ends the stomp is removed again. That used to print 'You have learned a new",
    "spell' and 'You have unlearned' every use. Expected over two uses: the Advance button shows the stomp and then",
    "Advance again, an empty button stays empty, no SMSG_SUPERCEDED_SPELL is sent and the client prints no line for",
    "either spell. #6475's recast behaviour is outside this scenario."
  ],
  "timeout_ms": 60000,
  "players": [
    {"id": "guardian", "race": 1, "class": 18, "level": 80}
  ],
  "steps": [
    {"action": "wait", "label": "Let login state settle", "ms": 3000},
    {"action": "learn", "actor": "guardian", "spell": 803130},
    {"action": "learn", "actor": "guardian", "spell": 500170},
    {"action": "set_power", "actor": "guardian", "power": 3, "value": 100},
    {"action": "cast", "actor": "guardian", "spell": 803130},
    {"action": "assert", "actor": "guardian", "metric": "aura", "spell": 803130, "equals": 1, "within_ms": 1000},
    {"action": "set_action_button", "actor": "guardian", "button": 1, "spell": 500170},
    {"action": "wait", "ms": 1200},
    {"action": "snapshot", "actor": "guardian", "metric": "client_chat_lines_for", "spell": 500170,
     "save_as": "advance_lines"},
    {"action": "snapshot", "actor": "guardian", "metric": "client_chat_lines_for", "spell": 500673,
     "save_as": "stomp_lines"},
    {"action": "snapshot", "actor": "guardian", "metric": "spellbook_superseded_packets", "save_as": "supersedes"},
    {"action": "cast", "label": "Advance", "actor": "guardian", "spell": 500170},
    {"action": "assert", "label": "Advance is swapped for its stomp", "actor": "guardian",
     "metric": "temporary_spell_replacement", "spell": 500170, "equals": 500673, "within_ms": 3000},
    {"action": "assert", "label": "The Advance button shows the stomp", "actor": "guardian",
     "metric": "client_action_button", "button": 1, "equals": 500673, "within_ms": 1000},
    {"action": "assert", "label": "Advance ends and hands its button back", "actor": "guardian",
     "metric": "temporary_spell_replacement", "spell": 500170, "equals": 500170, "within_ms": 10000},
    {"action": "assert", "label": "The button shows Advance again", "actor": "guardian",
     "metric": "client_action_button", "button": 1, "equals": 500170, "within_ms": 1000},
    {"action": "reset_cooldown", "actor": "guardian", "spell": 500170},
    {"action": "set_power", "actor": "guardian", "power": 3, "value": 100},
    {"action": "wait", "ms": 1600},
    {"action": "cast", "label": "Advance a second time", "actor": "guardian", "spell": 500170},
    {"action": "assert", "label": "The second Advance swaps in the stomp again", "actor": "guardian",
     "metric": "temporary_spell_replacement", "spell": 500170, "equals": 500673, "within_ms": 3000},
    {"action": "assert", "label": "The second Advance ends", "actor": "guardian",
     "metric": "temporary_spell_replacement", "spell": 500170, "equals": 500170, "within_ms": 10000},
    {"action": "assert", "label": "An empty button stays empty", "actor": "guardian", "metric": "client_action_button",
     "button": 119, "equals": 0},
    {"action": "assert", "label": "No swap was sent as SMSG_SUPERCEDED_SPELL", "actor": "guardian",
     "metric": "spellbook_superseded_packets", "relative_to": "supersedes", "equals": 0},
    {"action": "assert", "label": "The client printed no line for the stomp", "actor": "guardian",
     "metric": "client_chat_lines_for", "spell": 500673, "relative_to": "stomp_lines", "equals": 0},
    {"action": "assert", "label": "The client printed no line for Advance", "actor": "guardian",
     "metric": "client_chat_lines_for", "spell": 500170, "relative_to": "advance_lines", "equals": 0}
  ]
}
