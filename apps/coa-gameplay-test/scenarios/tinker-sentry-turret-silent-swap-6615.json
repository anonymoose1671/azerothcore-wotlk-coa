{
  "schema": 1,
  "name": "Build and Deconstruct Sentry Turret swap without a chat line or a new action button (#6615, #6489)",
  "contract": [
    "A built Sentry Turret teaches Deconstruct Sentry Turret 500470 as a temporary spell and swaps it in for",
    "Build: Sentry Turret 500239; deconstructing clears the swap. Each swap used to reach the client as",
    "SMSG_SUPERCEDED_SPELL, printing 'You have learned a new spell' and adding the spell to an empty button, so the",
    "bar filled up. Expected over two builds: the Build button shows Deconstruct and then Build again, an empty",
    "button stays empty, no SMSG_SUPERCEDED_SPELL is sent and the client prints no line for either spell."
  ],
  "timeout_ms": 90000,
  "players": [
    {"id": "tinker", "race": 1, "class": 28, "level": 2}
  ],
  "steps": [
    {"action": "wait", "label": "Let login state settle", "ms": 3000},
    {"action": "learn", "actor": "tinker", "spell": 500239},
    {"action": "set_action_button", "actor": "tinker", "button": 1, "spell": 500239},
    {"action": "wait", "ms": 1200},
    {"action": "snapshot", "actor": "tinker", "metric": "client_chat_lines_for", "spell": 500239, "save_as": "build_lines"},
    {"action": "snapshot", "actor": "tinker", "metric": "client_chat_lines_for", "spell": 500470,
     "save_as": "deconstruct_lines"},
    {"action": "snapshot", "actor": "tinker", "metric": "spellbook_superseded_packets", "save_as": "supersedes"},
    {"action": "cast", "label": "Build the turret", "actor": "tinker", "spell": 500239},
    {"action": "assert", "label": "Build is swapped for Deconstruct", "actor": "tinker",
     "metric": "temporary_spell_replacement", "spell": 500239, "equals": 500470, "within_ms": 3000},
    {"action": "assert", "label": "The Build button shows Deconstruct", "actor": "tinker",
     "metric": "client_action_button", "button": 1, "equals": 500470, "within_ms": 1000},
    {"action": "wait", "ms": 3500},
    {"action": "cast", "label": "Deconstruct the turret", "actor": "tinker", "spell": 500239},
    {"action": "assert", "label": "Deconstructing hands Build back", "actor": "tinker",
     "metric": "temporary_spell_replacement", "spell": 500239, "equals": 500239, "within_ms": 2000},
    {"action": "assert", "label": "The button shows Build again", "actor": "tinker", "metric": "client_action_button",
     "button": 1, "equals": 500239, "within_ms": 1000},
    {"action": "wait", "ms": 3500},
    {"action": "cast", "label": "Build a second turret", "actor": "tinker", "spell": 500239},
    {"action": "assert", "label": "The second build swaps in Deconstruct again", "actor": "tinker",
     "metric": "temporary_spell_replacement", "spell": 500239, "equals": 500470, "within_ms": 3000},
    {"action": "wait", "ms": 3500},
    {"action": "cast", "label": "Deconstruct the second turret", "actor": "tinker", "spell": 500239},
    {"action": "assert", "label": "The second deconstruct hands Build back", "actor": "tinker",
     "metric": "temporary_spell_replacement", "spell": 500239, "equals": 500239, "within_ms": 2000},
    {"action": "assert", "label": "An empty button stays empty", "actor": "tinker", "metric": "client_action_button",
     "button": 119, "equals": 0},
    {"action": "assert", "label": "No swap was sent as SMSG_SUPERCEDED_SPELL", "actor": "tinker",
     "metric": "spellbook_superseded_packets", "relative_to": "supersedes", "equals": 0},
    {"action": "assert", "label": "The client printed no line for Deconstruct", "actor": "tinker",
     "metric": "client_chat_lines_for", "spell": 500470, "relative_to": "deconstruct_lines", "equals": 0},
    {"action": "assert", "label": "The client printed no line for Build", "actor": "tinker",
     "metric": "client_chat_lines_for", "spell": 500239, "relative_to": "build_lines", "equals": 0}
  ]
}
